{
  "name": "dsh-warm-charcoal-theme",
  "version": "1.0.0",
  "description": "Warm Beige light palette and Dark Charcoal dark palette for DeepSeek Harness.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "dark-mode",
    "palette"
  ],
  "license": "MIT",
  "author": "595708049",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/595708049/warm-charcoal-theme.git"
  },
  "homepage": "https://github.com/595708049/warm-charcoal-theme#readme",
  "bugs": {
    "url": "https://github.com/595708049/warm-charcoal-theme/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./skin.json": "./skin.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skin.json",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "assets/*.png",
    "assets/screenshots/*.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    }
  }
}
